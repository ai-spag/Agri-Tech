<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>eAI-G9 Inc. 3D Robot Logo</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- OrbitControls for camera interaction -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <!-- FontLoader for 3D text -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/FontLoader.js"></script>
    <!-- TextGeometry for 3D text -->
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/geometries/TextGeometry.js"></script>
    <style>
        /* Custom font for a modern look */
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f2f5; /* Light grey background */
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh; /* Full viewport height */
            margin: 0;
            padding: 20px; /* Add some padding around the content */
            box-sizing: border-box;
            overflow: hidden; /* Prevent scrollbars */
        }
        .logo-container {
            background-color: #ffffff; /* White background for the logo card */
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1); /* Soft shadow */
            border-radius: 1.5rem; /* More rounded corners */
            padding: 1rem; /* Padding around the canvas */
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            max-width: 90%; /* Max width for responsiveness */
            width: 800px; /* Fixed width for larger screens */
            height: 600px; /* Fixed height for the container */
            text-align: center;
            position: relative; /* For z-index of background */
        }
        canvas {
            display: block;
            width: 100% !important; /* Ensure canvas fills container */
            height: 100% !important; /* Ensure canvas fills container */
            border-radius: 1rem; /* Rounded corners for the canvas */
            z-index: 1; /* Ensure canvas is above any pseudo-elements if used */
        }

        /* Responsive adjustments */
        @media (max-width: 768px) {
            .logo-container {
                width: 100%;
                height: 70vh; /* Adjust height for smaller screens */
                padding: 0.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="logo-container">
        <canvas id="robotLogoCanvas"></canvas>
    </div>

    <script type="module">
        // Ensure TextGeometry is available globally after import
        window.THREE = THREE;

        let scene, camera, renderer, robot, controls, textMesh;
        let font;
        let leftArm, rightArm; // References to arms for animation
        let hadoukenSphere = null; // To hold the Hadouken sphere
        let hadoukenLight = null; // To hold the Hadouken light
        let hadoukenAnimationState = 'idle'; // 'idle', 'charging', 'releasing'
        let hadoukenTimer = 0;
        const HADOUKEN_CHARGE_DURATION = 60; // Frames
        const HADOUKEN_RELEASE_DURATION = 90; // Frames
        let backgroundMaterial; // Declare backgroundMaterial globally

        // Shader for the background: Hyper speed motion blurry ocean of coding
        const backgroundVertexShader = `
            varying vec2 vUv;
            void main() {
                vUv = uv;
                gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            }
        `;

        const backgroundFragmentShader = `
            uniform float u_time;
            uniform vec3 u_color1; // Blue
            uniform vec3 u_color2; // Light Blue
            uniform vec3 u_color3; // Orange
            uniform vec3 u_color4; // Rose Gold

            varying vec2 vUv;

            void main() {
                vec2 uv = vUv;
                uv.x *= 2.0; // Stretch horizontally for "ocean" effect
                uv.y *= 1.5; // Stretch vertically

                // Create a wavy pattern
                float wave1 = sin(uv.x * 10.0 + u_time * 0.5) * 0.1;
                float wave2 = cos(uv.y * 8.0 + u_time * 0.7) * 0.08;
                float wave3 = sin(uv.x * 15.0 - u_time * 0.3) * 0.05;

                vec2 distortedUv = uv + vec2(wave1, wave2 + wave3);

                // Simulate coding lines
                float linePatternX = fract(distortedUv.x * 20.0);
                float linePatternY = fract(distortedUv.y * 15.0);

                float lineDensity = 0.02; // Thickness of lines

                float finalPattern = smoothstep(0.5 - lineDensity, 0.5 + lineDensity, linePatternX) +
                                     smoothstep(0.5 - lineDensity, 0.5 + lineDensity, linePatternY);

                // Blend colors based on pattern and position
                vec3 colorA = mix(u_color1, u_color2, distortedUv.y); // Blue to Light Blue vertically
                vec3 colorB = mix(u_color3, u_color4, distortedUv.x); // Orange to Rose Gold horizontally

                vec3 finalColor = mix(colorA, colorB, finalPattern * 0.5); // Blend based on line pattern

                gl_FragColor = vec4(finalColor, 1.0);
            }
        `;

        // Function to initialize the 3D scene
        function init() {
            // Scene setup
            scene = new THREE.Scene();

            // Camera setup
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 5, 20); // Adjust camera position

            // Renderer setup
            const canvas = document.getElementById('robotLogoCanvas');
            renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
            renderer.setSize(canvas.clientWidth, canvas.clientHeight);
            renderer.setPixelRatio(window.devicePixelRatio);

            // Orbit Controls for user interaction
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true; // Smooth camera movement
            controls.dampingFactor = 0.05;
            controls.screenSpacePanning = false;
            controls.minDistance = 10;
            controls.maxDistance = 50;
            controls.maxPolarAngle = Math.PI / 2; // Prevent camera from going below the ground

            // Lighting
            const ambientLight = new THREE.AmbientLight(0x404040, 2); // Soft white light
            scene.add(ambientLight);

            const directionalLight = new THREE.DirectionalLight(0xffffff, 1); // White directional light
            directionalLight.position.set(5, 10, 7);
            scene.add(directionalLight);

            const directionalLight2 = new THREE.DirectionalLight(0xffffff, 0.5); // Another light for better illumination
            directionalLight2.position.set(-5, -10, -7);
            scene.add(directionalLight2);

            // Add the shader background
            const backgroundGeometry = new THREE.PlaneGeometry(100, 100);
            backgroundMaterial = new THREE.ShaderMaterial({ // Assign to global variable
                uniforms: {
                    u_time: { value: 0.0 },
                    u_color1: { value: new THREE.Color(0x0000FF) },     // Blue
                    u_color2: { value: new THREE.Color(0xADD8E6) },     // Light Blue
                    u_color3: { value: new THREE.Color(0xFFA500) },     // Orange
                    u_color4: { value: new THREE.Color(0xB76E79) }      // Rose Gold (approximated)
                },
                vertexShader: backgroundVertexShader,
                fragmentShader: backgroundFragmentShader,
                side: THREE.DoubleSide // Render both sides
            });
            const backgroundPlane = new THREE.Mesh(backgroundGeometry, backgroundMaterial);
            backgroundPlane.position.z = -30; // Place it behind the robot
            scene.add(backgroundPlane);

            // Load font for 3D text
            const fontLoader = new THREE.FontLoader();
            fontLoader.load('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/fonts/helvetiker_regular.typeface.json', function (loadedFont) {
                font = loadedFont;
                createRobot(); // Create robot after font is loaded
                // Start Hadouken animation automatically after a delay
                setTimeout(() => {
                    startHadouken();
                }, 5000); // Start after 5 seconds
                animate(); // Start animation loop
            });

            // Handle window resizing
            window.addEventListener('resize', onWindowResize, false);
        }

        // Function to create the robot model
        function createRobot() {
            robot = new THREE.Group(); // Group to hold all robot parts

            // Materials for robot parts
            const metallicMaterial = new THREE.MeshStandardMaterial({
                color: 0x333333, // Darker Grey metallic
                metalness: 0.9,
                roughness: 0.2
            });
            const goldMaterial = new THREE.MeshStandardMaterial({
                color: 0xFFD700, // Gold
                metalness: 0.9,
                roughness: 0.1
            });
            const denimMaterial = new THREE.MeshStandardMaterial({
                color: 0x2A52BE, // Denim blue
                roughness: 0.7,
                metalness: 0.1
            });
            const diamondMaterial = new THREE.MeshStandardMaterial({
                color: 0xFFFFFF, // White
                metalness: 1.0,
                roughness: 0.0,
                envMapIntensity: 1.5 // Make it very reflective
            });
            // Add a cube camera for environment map for reflections on diamonds
            const cubeRenderTarget = new THREE.WebGLCubeRenderTarget(128, {
                format: THREE.RGBFormat,
                generateMipmaps: true,
                minFilter: THREE.LinearMipmapLinearFilter
            });
            const cubeCamera = new THREE.CubeCamera(1, 1000, cubeRenderTarget);
            scene.add(cubeCamera);
            diamondMaterial.envMap = cubeRenderTarget.texture;


            // Body
            const bodyGeometry = new THREE.BoxGeometry(6, 8, 4);
            const body = new THREE.Mesh(bodyGeometry, metallicMaterial);
            robot.add(body);

            // Head
            const headGeometry = new THREE.BoxGeometry(4, 3, 3);
            const head = new THREE.Mesh(headGeometry, metallicMaterial);
            head.position.y = 5.5;
            robot.add(head);

            // Neck (gold cylinder)
            const neckGeometry = new THREE.CylinderGeometry(0.8, 0.8, 1, 16);
            const neck = new THREE.Mesh(neckGeometry, goldMaterial);
            neck.position.y = 4;
            robot.add(neck);

            // Diamond Necklaces
            const numDiamonds = 12;
            const necklaceRadius = 1.2;
            const diamondGeometry = new THREE.IcosahedronGeometry(0.2, 0); // Small, faceted sphere
            for (let i = 0; i < numDiamonds; i++) {
                const angle = (i / numDiamonds) * Math.PI * 2;
                const x = necklaceRadius * Math.cos(angle);
                const z = necklaceRadius * Math.sin(angle);
                const diamond = new THREE.Mesh(diamondGeometry, diamondMaterial);
                diamond.position.set(x, 4, z); // Around the neck
                robot.add(diamond);
            }

            // Arms (simple cylinders, now with proper pivot for rotation)
            const armGeometry = new THREE.CylinderGeometry(1, 1, 6, 16);

            leftArm = new THREE.Group(); // Group for left arm to set pivot
            const leftArmMesh = new THREE.Mesh(armGeometry, metallicMaterial);
            leftArmMesh.position.y = -3; // Move cylinder down so pivot is at top
            leftArm.add(leftArmMesh);
            leftArm.position.set(-4, 0, 0); // Position the arm group
            robot.add(leftArm);

            rightArm = new THREE.Group(); // Group for right arm to set pivot
            const rightArmMesh = new THREE.Mesh(armGeometry, metallicMaterial);
            rightArmMesh.position.y = -3; // Move cylinder down so pivot is at top
            rightArm.add(rightArmMesh);
            rightArm.position.set(4, 0, 0); // Position the arm group
            robot.add(rightArm);

            // Legs (denim material)
            const legGeometry = new THREE.CylinderGeometry(1.2, 1.2, 7, 16);
            const leftLeg = new THREE.Mesh(legGeometry, denimMaterial);
            leftLeg.position.set(-2, -7.5, 0);
            robot.add(leftLeg);

            const rightLeg = new THREE.Mesh(legGeometry, denimMaterial);
            rightLeg.position.set(2, -7.5, 0);
            robot.add(rightLeg);

            // Feet (gold accents)
            const footGeometry = new THREE.BoxGeometry(2, 1, 3);
            const leftFoot = new THREE.Mesh(footGeometry, goldMaterial);
            leftFoot.position.set(-2, -11.5, 0.5);
            robot.add(leftFoot);

            const rightFoot = new THREE.Mesh(footGeometry, goldMaterial);
            rightFoot.position.set(2, -11.5, 0.5);
            robot.add(rightFoot);

            // Add "eAI-G9" text to the robot's chest
            if (font) {
                const textMaterial = new THREE.MeshStandardMaterial({
                    color: 0xC0C0C0, // Silver for text
                    emissive: 0xC0C0C0, // Make it glow
                    emissiveIntensity: 0.8, // Bright illumination
                    metalness: 0.9,
                    roughness: 0.1
                });
                const textGeometry = new THREE.TextGeometry('eAI-G9', {
                    font: font,
                    size: 1.5, // Size of the text
                    height: 0.3, // Depth of the text
                    curveSegments: 12,
                    bevelEnabled: true,
                    bevelThickness: 0.1,
                    bevelSize: 0.05,
                    bevelOffset: 0,
                    bevelSegments: 5
                });
                textGeometry.computeBoundingBox();
                const textWidth = textGeometry.boundingBox.max.x - textGeometry.boundingBox.min.x;
                textMesh = new THREE.Mesh(textGeometry, textMaterial);
                textMesh.position.set(-textWidth / 2, 1, 2.1); // Position on the chest
                robot.add(textMesh);
            }

            scene.add(robot);
            robot.position.y = 2; // Lift robot slightly from the ground
            cubeCamera.position.copy(robot.position); // Position cube camera at robot for reflections
        }

        // Function to start the Shakunetsu Hadouken animation
        function startHadouken() {
            if (hadoukenAnimationState === 'idle') {
                hadoukenAnimationState = 'charging';
                hadoukenTimer = 0;

                // Create Hadouken sphere
                const hadoukenMaterial = new THREE.MeshStandardMaterial({
                    color: 0xFF4500, // Orange-red for fire
                    emissive: 0xFF4500,
                    emissiveIntensity: 0, // Start with no emissive intensity
                    metalness: 0.1,
                    roughness: 0.5,
                    transparent: true,
                    opacity: 0.1
                });
                hadoukenSphere = new THREE.Mesh(new THREE.SphereGeometry(0.1, 32, 32), hadoukenMaterial);
                hadoukenSphere.position.set(0, 0, 3); // Initial position relative to robot chest
                robot.add(hadoukenSphere);

                // Create Hadouken light
                hadoukenLight = new THREE.PointLight(0xFF4500, 0, 20); // Color, intensity, distance
                hadoukenSphere.add(hadoukenLight); // Attach light to sphere
            }
        }

        // Animation loop
        function animate() {
            requestAnimationFrame(animate);

            controls.update(); // Update orbit controls

            // Update background shader time - check if backgroundMaterial exists
            if (backgroundMaterial && backgroundMaterial.uniforms && backgroundMaterial.uniforms.u_time) {
                backgroundMaterial.uniforms.u_time.value += 0.01;
            }

            // Subtle continuous rotation for robot
            if (robot) {
                robot.rotation.y += 0.005; // Rotate slowly
            }

            // Update cube camera for reflections
            const cubeCamera = scene.children.find(obj => obj instanceof THREE.CubeCamera);
            if (cubeCamera) {
                cubeCamera.update(renderer, scene);
            }


            // Hadouken animation logic
            if (hadoukenAnimationState === 'charging') {
                hadoukenTimer++;
                const progress = hadoukenTimer / HADOUKEN_CHARGE_DURATION;

                // Arms move forward and inward
                leftArm.rotation.x = -Math.PI / 2 * progress;
                leftArm.rotation.z = Math.PI / 6 - (Math.PI / 6) * progress;
                rightArm.rotation.x = -Math.PI / 2 * progress;
                rightArm.rotation.z = -Math.PI / 6 + (Math.PI / 6) * progress;

                // Hadouken sphere grows and glows
                if (hadoukenSphere) {
                    hadoukenSphere.scale.setScalar(progress * 5); // Grow to max size 5
                    hadoukenSphere.position.z = 2.1 + progress * 0.5; // Move slightly forward
                    hadoukenSphere.material.emissiveIntensity = progress * 3; // Increase glow
                    hadoukenSphere.material.opacity = 0.1 + progress * 0.7; // Increase opacity
                }
                // Hadouken light intensity increases
                if (hadoukenLight) {
                    hadoukenLight.intensity = progress * 5; // Increase light intensity
                }

                if (hadoukenTimer >= HADOUKEN_CHARGE_DURATION) {
                    hadoukenAnimationState = 'releasing';
                    hadoukenTimer = 0;
                }
            } else if (hadoukenAnimationState === 'releasing') {
                hadoukenTimer++;
                const progress = hadoukenTimer / HADOUKEN_RELEASE_DURATION;

                // Arms snap back slightly
                leftArm.rotation.x = -Math.PI / 2 * (1 - progress * 0.2);
                rightArm.rotation.x = -Math.PI / 2 * (1 - progress * 0.2);

                // Hadouken sphere shoots forward, expands, and fades
                if (hadoukenSphere) {
                    hadoukenSphere.position.z = 2.6 + progress * 25; // Shoot much further forward
                    hadoukenSphere.material.opacity = 1 - progress; // Fade out
                    hadoukenSphere.material.emissiveIntensity = 3 * (1 - progress); // Fade glow
                    hadoukenSphere.scale.setScalar(5 * (1 + progress * 0.5)); // Expand further as it moves
                }
                // Hadouken light intensity fades
                if (hadoukenLight) {
                    hadoukenLight.intensity = 5 * (1 - progress); // Fade light intensity
                }

                if (hadoukenTimer >= HADOUKEN_RELEASE_DURATION) {
                    hadoukenAnimationState = 'idle';
                    hadoukenTimer = 0;
                    if (hadoukenSphere) {
                        robot.remove(hadoukenSphere); // Remove sphere from scene
                        hadoukenSphere.geometry.dispose();
                        hadoukenSphere.material.dispose();
                        hadoukenSphere = null;
                    }
                    if (hadoukenLight) {
                        hadoukenLight.dispose();
                        hadoukenLight = null;
                    }
                    // Reset arms to original position
                    leftArm.rotation.set(0, 0, 0);
                    rightArm.rotation.set(0, 0, 0);

                    // Trigger next Hadouken after a delay
                    setTimeout(() => {
                        startHadouken();
                    }, 5000); // Wait 5 seconds before next Hadouken
                }
            }


            renderer.render(scene, camera);
        }

        // Handle window resize
        function onWindowResize() {
            const canvas = document.getElementById('robotLogoCanvas');
            camera.aspect = canvas.clientWidth / canvas.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(canvas.clientWidth, canvas.clientHeight);
        }

        // Initialize the scene when the window loads
        window.onload = function () {
            init();
        };
    </script>
</body>
</html>
